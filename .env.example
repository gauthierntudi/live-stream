APP_NAME="Live Stream"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Fond page « paiement réussi » : URL https… ou chemin sous public/ (ex. img/mon-fond.jpg). Sinon : public/img/success-bg.webp|.jpg|.png
# DONATION_SUCCESS_BACKGROUND=

# Vidéo du carrousel hero (accueil) — MP4 Cloudinary ou autre URL directe
# HOME_HERO_VIDEO_URL=https://res.cloudinary.com/dfqlmkknv/video/upload/v1779040274/davidize_hved2d.mp4

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Streaming — aws_ivs (défaut) | cloudflare | youtube
# Surcharge possible depuis l’admin (Live) : enregistré en base (settings), prioritaire sur cette variable.
STREAMING_PROVIDER=aws_ivs
# AWS IVS (utilise aussi AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
AWS_IVS_REGION=eu-west-1
# Optionnel si canal créé via le dashboard admin
AWS_IVS_CHANNEL_ARN=
AWS_IVS_PLAYBACK_URL=

VITE_APP_NAME="${APP_NAME}"

# Dashboard admin (php artisan db:seed --class=AdminUserSeeder)
ADMIN_EMAIL=admin@live-stream.web
ADMIN_PASSWORD=
# Nom exact du site sécurisé dans Herd (sensible à la casse). Ex. LIVE-STREAM.web
VITE_TLS_HOST=

# Cloudflare Stream / Live (si STREAMING_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_LIVE_INPUT_UID=
CLOUDFLARE_STREAM_VIDEO_UID=
# URL iframe / HLS complète si tu ne passes pas par VIDEO_UID
CLOUDFLARE_STREAM_PLAYBACK_URL=

# YouTube — lecture embed uniquement (STREAMING_PROVIDER=youtube ou choix admin). Ingest : YouTube Studio / OBS → YouTube.
# Priorité : valeur saisie dans l’admin Live > cette variable .env
# ID vidéo (11 caractères) ou URL watch / youtu.be / embed / shorts / live
YOUTUBE_LIVE_VIDEO_ID=
# Optionnel : URL iframe complète (prioritaire sur YOUTUBE_LIVE_VIDEO_ID si renseignée)
# YOUTUBE_LIVE_EMBED_URL=
# Lecture embed : autoplay par défaut (navigateur peut exiger mute=1 pour lecture sans clic ; sinon désactivez le son avec mute ci‑dessous).
YOUTUBE_EMBED_AUTOPLAY=true
YOUTUBE_EMBED_MUTED=false

# PayPal.me (bouton externe sur /soutenir, hors MaxiCash)
PAYPAL_ME_URL=https://www.paypal.me/AtmosphereFam

# MaxiCash — même schéma que scripts-examples/ (MerchantID + MerchantPassword JSON)
MAXICASH_MERCHANT_ID=
MAXICASH_MERCHANT_PASSWORD=
# test | live
MAXICASH_API_MODE=test
# URLs (optionnel) — par défaut : webapi-test si MAXICASH_API_MODE=test, webapi si live
# MAXICASH_MOBILE_URL=
# Carte (redirection page MaxiCash) — étape 1 : PayEntryWeb (NE PAS utiliser PayCreditCard ici)
# MAXICASH_PAY_ENTRY_WEB_URL=https://webapi.maxicashapp.com/Integration/PayEntryWeb
# Étape 2 : https://api.maxicashapp.com/payentryweb?logid={LogID}
# MAXICASH_GATEWAY_CHECKOUT_URL=
# Ancienne variable (ignorée si = PayCreditCard) :
# MAXICASH_CARD_URL=
# Bearer optionnel sur POST /webhooks/maxicash
MAXICASH_WEBHOOK_SECRET=
# PayNowSync : doc ~420 s — augmente nginx (ex. fastcgi_read_timeout 450s) et PHP max_execution_time en prod
# MAXICASH_PAYNOW_TIMEOUT=420
# MAXICASH_CARD_TIMEOUT=120
# MAXICASH_CONNECT_TIMEOUT=30
# MAXICASH_HTTP_ATTEMPTS=1
